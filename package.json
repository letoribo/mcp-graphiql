{
  "name": "mcp-graphiql",
  "private": true,
  "version": "0.1.1",
  "description": "MCP GraphiQL Client",
  "author": "letoribo <yuchistyakov@gmail.com>",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "cross-env ENABLE_HTTP=true node server",
    "server:watch": "cross-env ENABLE_HTTP=true nodemon --watch server.js --watch electron server.js",
    "electron:dev": "cross-env NODE_OPTIONS=--no-deprecation DISABLE_GPU=true VITE_DEV_SERVER_URL=http://localhost:5173 concurrently --kill-others -k -s first \"npm run dev\" \"wait-on tcp:5173 && nodemon --watch electron --exec electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.letoribo.mcpgraphiql",
    "productName": "MCP GraphiQL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "electron",
      "server.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@letoribo/mcp-graphql-enhanced": "^4.15.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphiql": "^5.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^9.1.0"
  }
}
